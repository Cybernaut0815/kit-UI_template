{
  "name": "@gitzhacode/zha-ui-tokens",
  "version": "0.2.0",
  "author": "Aleksander Mastalski <Aleksander.Mastalski@zha.com>",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      }
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind": {
      "import": {
        "types": "./dist/tailwind-preset.d.ts",
        "default": "./dist/tailwind-preset.js"
      }
    },
    "./tokens.json": "./dist/tokens.json",
    "./llms.txt": "./dist/llms.txt"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node style-dictionary.config.mjs && node scripts/contrast-matrix.mjs",
    "contrast": "node scripts/contrast-matrix.mjs",
    "test": "vitest run",
    "lint": "tsc --noEmit -p .",
    "validate": "attw --pack . --profile esm-only --exclude-entrypoints tokens.css llms.txt"
  },
  "dependencies": {
    "culori": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "style-dictionary": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GitZHACODE/zha-ui.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
