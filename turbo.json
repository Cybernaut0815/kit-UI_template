{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/examples/_drift-guard.mjs", "$TURBO_ROOT$/examples/drift-guard.test.mjs", "$TURBO_ROOT$/examples/index.html"] },
    "test": { "dependsOn": ["build"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/skills/**", "$TURBO_ROOT$/**/SKILL.md"] },
    "lint": {}
  }
}
